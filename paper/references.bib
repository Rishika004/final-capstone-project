@inproceedings{yu2023antifake,
  title     = {AntiFake: Using Adversarial Audio to Prevent Unauthorized Speech Synthesis},
  author    = {Yu, Zhiyuan and Zhai, Shixuan and Zhang, Ning},
  booktitle = {Proceedings of the 2023 ACM SIGSAC Conference on Computer and
               Communications Security (CCS '23)},
  pages     = {460--474},
  year      = {2023},
  address   = {Copenhagen, Denmark},
  publisher = {ACM},
  doi       = {10.1145/3576915.3623209},
  url       = {https://cybersecurity.seas.wustl.edu/paper/AntiFakeCCS23.pdf},
  note      = {Verified against the published PDF 2026-09-17. Two facts we cite.
               (1) The pre-filter: AERR is defined only over samples already
               filtered to bypass SV without AntiFake. (2) Table 4, Sec. 6.7:
               rows are the CRAFTING encoder, columns five evaluated SYNTHESIZERS
               (not encoders -- the match is implicit via each synthesizer's
               internal encoder). Single-encoder crafting gives 99.6-100 % AERR on
               the synthesizer built on that encoder and 0-20.6 % on the other
               four; the GE2E row, our case, is 100 % on SV2TTS against
               1.2-20.6 % elsewhere. The synthesizer<->encoder pairing is EXPLICIT
               in Sec. 6.1 only for SV2TTS (GE2E) and YourTTS (H/ASP); AdaptVC
               (AdaIN) is implied and Tortoise is unstated, so rely only on the
               first two. CAUTION, and this was misread twice before it was
               got right: Table 4 is not LABELLED a leave-one-out protocol and has
               no LOO aggregate, but its subset rows that omit the matching encoder
               ARE de-facto held-out cells -- e.g. 2+3+4, which excludes AdaIN,
               gives 74.8 % on AdaptVC, and 1+2+3, which excludes ViT, gives 24.6 %
               on Tortoise, against ~99 % for the full ensemble. So it is weak
               evidence that the protocol is unnamed and strong evidence that the
               numbers already exist. (3) Sec. 7 "Overlapped Encoders" concedes the problem
               our fix F1 addresses -- their evaluated synthesizers' encoders
               overlap their own ensemble -- and argues from Table 4 that
               "different levels of transferability exist even when entirely
               different encoders were used for optimization and synthesis",
               naming systematic cross-encoder study as future work.}
}

